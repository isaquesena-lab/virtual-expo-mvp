{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "virtual-expo-mvp",
  "compatibility_date": "2025-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "wetexpo.prohound.io", "custom_domain": true }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "virtual-expo-db",
      "database_id": "f56e24a9-c222-4b5a-a60b-8ef4f5ae0ea4",
      "migrations_dir": "migrations"
    }
  ],
  // Public widget key. The form renders Turnstile when TURNSTILE_SECRET is also set.
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAF8paSM2MSgm5B03"
  },
  // Per-IP rate limit for public booth submissions (anti-spam / slot squatting).
  "ratelimits": [
    {
      "name": "SUBMIT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    // Per-IP rate limit for owner mutations (live heartbeat, logo upload).
    {
      "name": "MUTATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
